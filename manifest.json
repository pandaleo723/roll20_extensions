{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.5.0",
  "default_locale": "en",
  "description": "__MSG_extDesc__",
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "src/popup/popup.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.roll20.net/*"
      ],
      "js": [
        "src/shared/settings.js",
        "src/content/fields.js",
        "src/content/sheet.js",
        "src/content/picker.js",
        "src/modules/spells/fill.js",
        "src/modules/spells/view.js",
        "src/modules/spells/module.js",
        "src/modules/items/fill.js",
        "src/modules/items/view.js",
        "src/modules/items/module.js",
        "src/modules/traits/fill.js",
        "src/modules/traits/view.js",
        "src/modules/traits/species.js",
        "src/modules/traits/module.js",
        "src/content/content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://storage.googleapis.com/roll20-cdn/*"
      ],
      "js": [
        "src/shared/settings.js",
        "src/content/fields.js",
        "src/content/sheet.js",
        "src/content/picker.js",
        "src/modules/spells/fill.js",
        "src/modules/spells/view.js",
        "src/modules/spells/module.js",
        "src/modules/items/fill.js",
        "src/modules/items/view.js",
        "src/modules/items/module.js",
        "src/modules/traits/fill.js",
        "src/modules/traits/view.js",
        "src/modules/traits/species.js",
        "src/modules/traits/module.js",
        "src/content/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
