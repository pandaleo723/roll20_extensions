{
  "manifest_version": 3,
  "name": "Roll20 Sheet Filler",
  "version": "0.2.0",
  "description": "Fill a D&D character sheet on Roll20 from a spell list or JSON data.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "action": {
    "default_title": "Roll20 Sheet Filler",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.roll20.net/*"
      ],
      "js": [
        "src/shared/settings.js",
        "src/content/fields.js",
        "src/content/spells.js",
        "src/content/picker.js",
        "src/content/sections.js",
        "src/content/content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://storage.googleapis.com/roll20-cdn/*"
      ],
      "js": [
        "src/shared/settings.js",
        "src/content/fields.js",
        "src/content/spells.js",
        "src/content/picker.js",
        "src/content/sections.js",
        "src/content/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
