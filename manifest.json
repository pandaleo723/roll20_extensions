{
  "manifest_version": 3,
  "name": "Roll20 Sheet Filler",
  "version": "0.1.0",
  "description": "Fill a D&D character sheet on Roll20 from JSON data.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Roll20 Sheet Filler",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://app.roll20.net/*"],
      "js": ["src/content/content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://storage.googleapis.com/roll20-cdn/*"],
      "js": ["src/content/content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
